# Server-side only. Use Stripe sandbox/test values; live keys are rejected.
APP_URL=http://localhost:4317
STRIPE_SECRET_KEY=
STRIPE_ANNUAL_PRICE_ID=
# Activated Stripe test customer portal login URL, not a temporary session URL.
# Example format: https://billing.stripe.com/p/login/test_...
STRIPE_CUSTOMER_PORTAL_URL=
# Existing D1 database, used by founding-list, trade-in, note and analytics routes.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Clerk authentication. The CLI provisions development keys in ignored .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/join
# Persistent stock and checkout reservations (Neon integration supplies INVENTORY_DATABASE_URL).
INVENTORY_DATABASE_URL=
# Stripe TEST webhook: completed / async_payment_succeeded / expired checkout sessions.
STRIPE_WEBHOOK_SECRET=

# Shippo server-only configuration. Test and live credentials never fall back.
SHIPPING_PROVIDER=shippo
SHIPPO_MODE=test
SHIPPO_AUTOMATION_ENABLED=false
SHIPPO_TEST_WORKFLOWS_ENABLED=false
SHIPPO_TEST_TOKEN=
SHIPPO_LIVE_TOKEN=
# JSON ShippingAddress: name,line1,line2(optional),city,region,postalCode,country
SHIPPO_COMPANY_ADDRESS=
# Optional separate JSON addresses; default to COMPANY_ADDRESS.
SHIPPO_FULFILLMENT_ADDRESS=
SHIPPO_RECEIVING_ADDRESS=
SHIPPO_BUSINESS_EMAIL=
SHIPPO_BUSINESS_PHONE=
SHIPPO_CARRIERS=usps,ups,fedex
SHIPPO_SERVICES=usps_ground_advantage,usps_priority,ups_ground,fedex_ground,fedex_home_delivery
SHIPPO_MAX_VALUE_CENTS=100000
SHIPPO_MAX_RATE_CENTS=5000
SHIPPO_SIGNATURE_THRESHOLD_CENTS=50000
SHIPPO_MAX_AUTOMATIC_CARDS=10
SHIPPO_INSURANCE_PROVIDER=xcover
SHIPPO_WEBHOOK_TOKEN=
CRON_SECRET=
# Live gates remain false until separately approved and verified.
SHIPPO_LIVE_ACTIVATION_APPROVED=false
SHIPPO_PRODUCTION_READY=false
SHIPPO_BUSINESS_ADDRESS_VERIFIED=false
SHIPPO_PACKAGING_VERIFIED=false
SHIPPO_PACKING_PROFILES=
SHIPPO_COLLECTIBLES_COVERAGE_VERIFIED=false
SHIPPO_COVERAGE_REFERENCE=
