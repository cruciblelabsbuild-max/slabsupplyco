# Server-side only. Use Stripe sandbox/test values; live keys are rejected.
APP_URL=http://localhost:4317
STRIPE_SECRET_KEY=
STRIPE_ANNUAL_PRICE_ID=
# Activated Stripe test customer portal login URL, not a temporary session URL.
# Example format: https://billing.stripe.com/p/login/test_...
STRIPE_CUSTOMER_PORTAL_URL=
# Existing D1 database, used by founding-list, trade-in, note and analytics routes.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Clerk authentication. The CLI provisions development keys in ignored .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/join
# Persistent stock and checkout reservations (Neon integration supplies INVENTORY_DATABASE_URL).
INVENTORY_DATABASE_URL=
# Stripe TEST webhook: completed / async_payment_succeeded / expired checkout sessions.
STRIPE_WEBHOOK_SECRET=
